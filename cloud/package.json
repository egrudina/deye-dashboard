{
  "name": "deye-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "migrate:local": "wrangler d1 migrations apply deye --local",
    "migrate:remote": "wrangler d1 migrations apply deye --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "wrangler": "4.158.0"
  }
}
