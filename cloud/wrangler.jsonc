{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deye",
  "account_id": "3fae08562845acf47655d88931077e2d",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "deye.grudina.info", "custom_domain": true }],
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    // The Worker checks the Access JWT before serving anything, including static files.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deye",
      "database_id": "73f45405-83b2-4151-bbf5-efb0f15f70c8",
      "migrations_dir": "migrations"
    }
  ],
  // Hourly: purge raw_samples and heartbeats older than 7 days, calibration.
  // Every 15 min: energy rollups, Yasno schedule, Solcast (when a call is due), notifications.
  "triggers": { "crons": ["17 * * * *", "*/15 * * * *"] },
  "vars": {
    // Filled after the Access application exists (Zero Trust → Access → Applications → <app> → Overview).
    // Empty = every non-ingest request gets 503 (fail closed).
    "ACCESS_TEAM_DOMAIN": "https://deye-kyiv-1.cloudflareaccess.com",
    "ACCESS_AUD": "c237a5c1932be80b9933b42fcfff9f7227c676e7939e41a0ed2f7a94c92f3b84"
  },
  // Secrets (not here): PUSH_KEY, SOLCAST_API_KEY, SOLCAST_RESOURCE_ID, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT. Local dev: .dev.vars (gitignored).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
