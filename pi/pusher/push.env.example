# Copy to push.env next to this file (chmod 600). Never commit the real file.

# Your Worker's ingest URL and the same PUSH_KEY as the Worker secret (openssl rand -hex 32).
PUSH_URL=https://deye.example.com/api/ingest
PUSH_KEY=<64 hex chars, same as the Worker secret>
PUSH_INTERVAL=30

# Standalone mode only (standalone.py): the Solarman Wi-Fi logger stick of the inverter.
# IP: fixed (DHCP reservation) address of the stick in your LAN. SERIAL: the logger's serial number from its label
# (10 digits, not the inverter's serial).
INVERTER_IP=192.168.1.50
INVERTER_SERIAL=1234567890
INVERTER_PORT=8899
